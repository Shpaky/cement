---
/**
 * Единая 404 для всех локалей (GitHub Pages отдаёт /404.html).
 * Показываем сообщение на трёх языках со ссылками на соответствующие главные.
 */
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import Logo from '../components/Logo.astro';
import { LANGS, LANG_NAMES, getDict, localePath } from '../i18n';
import Base from '../layouts/Base.astro';

const dict = getDict('en');
---

<Base lang="en" dict={dict} title={`404 — ${dict.notFound.title}`} noindex>
  <Container class="flex min-h-svh flex-col items-center justify-center py-16 text-center">
    <Logo
      href={localePath('en')}
      brandLine={dict.common.brandLine}
      tagline={dict.common.brandTagline}
    />
    <p class="mt-10 text-sm font-bold tracking-widest text-brand-600 uppercase">404</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-brand-800 md:text-5xl">
      {dict.notFound.title}
    </h1>
    <p class="mt-4 max-w-md text-ink-700">{dict.notFound.text}</p>

    <ul class="mt-10 grid w-full max-w-2xl gap-4 sm:grid-cols-3">
      {
        LANGS.map((lang) => {
          const d = getDict(lang);
          return (
            <li lang={lang} class="rounded-lg border border-ink-200 bg-white p-5 shadow-card">
              <p class="text-xs font-bold tracking-widest text-ink-500 uppercase">
                {LANG_NAMES[lang]}
              </p>
              <p class="mt-2 text-sm text-ink-700">{d.notFound.text}</p>
              <Button href={localePath(lang)} variant="secondary" class="mt-4 w-full">
                {d.notFound.cta}
              </Button>
            </li>
          );
        })
      }
    </ul>
  </Container>
</Base>
