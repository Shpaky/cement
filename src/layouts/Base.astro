---
import '../styles/global.css';
import manropeLatin from '../assets/fonts/manrope-latin.woff2';
import manropeCyrillic from '../assets/fonts/manrope-cyrillic.woff2';
import notoDevanagari from '../assets/fonts/noto-sans-devanagari.woff2';
import { company } from '../data/company';
import { LANGS, LOCALE_TAGS, localeUrl, type Dictionary, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  dict: Dictionary;
  /** Переопределение <title> (например, для 404) */
  title?: string;
  /** Служебные страницы не индексируем */
  noindex?: boolean;
}

const { lang, dict, title = dict.meta.title, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const canonical = localeUrl(lang);
const ogImage = `${site}${base}og/${lang}.png`;

/** Предзагрузка только тех субсетов, что реально нужны локали. */
const preloadFonts =
  lang === 'hi'
    ? [notoDevanagari, manropeLatin]
    : lang === 'ru'
      ? [manropeCyrillic, manropeLatin]
      : [manropeLatin];

/** schema.org Organization — контакты и адрес пока плейсхолдеры (см. company.ts). */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: dict.company.name,
  alternateName: company.brand,
  url: canonical,
  logo: `${site}${base}apple-touch-icon.png`,
  image: ogImage,
  description: dict.meta.description,
  email: company.email,
  telephone: company.phones.in.display,
  address: { '@type': 'PostalAddress', streetAddress: dict.company.address, addressCountry: 'RU' },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: company.phones.in.display,
      areaServed: 'IN',
      availableLanguage: ['en', 'hi'],
    },
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: company.phones.ru.display,
      areaServed: 'RU',
      availableLanguage: ['ru', 'en'],
    },
  ],
  sameAs: [company.whatsapp, company.telegram],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={dict.meta.description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={LOCALE_TAGS[l]} href={localeUrl(l)} />)}
    <link rel="alternate" hreflang="x-default" href={localeUrl('en')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={dict.common.brandLine} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={dict.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.meta.title} />
    <meta property="og:locale" content={LOCALE_TAGS[lang].replace('-', '_')} />
    {
      LANGS.filter((l) => l !== lang).map((l) => (
        <meta property="og:locale:alternate" content={LOCALE_TAGS[l].replace('-', '_')} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={dict.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    {/* tokens-ignore: theme-color по спецификации принимает только литерал цвета */}
    <meta name="theme-color" content="#203b80" /><!-- tokens-ignore: = --color-brand-800 -->
    <meta name="generator" content={Astro.generator} />

    {
      preloadFonts.map((href) => (
        <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
      ))
    }

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-svh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-brand-800 px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {dict.common.skipToContent}
    </a>
    <slot name="header" />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
