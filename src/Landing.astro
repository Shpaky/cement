---
/**
 * Единая сборка лендинга для всех локалей: порядок секций задаётся здесь.
 */
import Footer from './components/Footer.astro';
import Header from './components/Header.astro';
import About from './components/sections/About.astro';
import Advantages from './components/sections/Advantages.astro';
import Certificates from './components/sections/Certificates.astro';
import Contacts from './components/sections/Contacts.astro';
import Facts from './components/sections/Facts.astro';
import Faq from './components/sections/Faq.astro';
import Hero from './components/sections/Hero.astro';
import Logistics from './components/sections/Logistics.astro';
import Products from './components/sections/Products.astro';
import { company } from './data/company';
import { productsByGroup } from './data/products';
import { getDict, pageUrl, sectionNav, type Lang } from './i18n';
import Base from './layouts/Base.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = getDict(lang);
const nav = sectionNav(lang, dict);
/** В шапке «Контакты» заменяет кнопка CTA. */
const headerNav = nav.filter((item) => item.href !== '#contacts');

/** schema.org Product для линейки D5 (характеристики не указываем до получения TDS). */
const productJsonLd = productsByGroup('waterproofing').map((p) => {
  const item = dict.products.items[p.id];
  return {
    '@type': 'Product',
    name: item.name,
    description: item.tagline,
    category: dict.products.groups.waterproofing.title,
    brand: { '@type': 'Brand', name: company.brand },
    manufacturer: { '@type': 'Organization', name: dict.company.name },
    url: `${pageUrl(lang, 'home')}#products`,
  };
});
---

<Base lang={lang} dict={dict} page="home" jsonLd={productJsonLd}>
  <Header slot="header" lang={lang} dict={dict} nav={headerNav} page="home" />

  <Hero dict={dict} />
  <About dict={dict} />
  <Facts dict={dict} />
  <Products dict={dict} />
  <Advantages dict={dict} />
  <Logistics dict={dict} />
  <Certificates dict={dict} />
  <Faq dict={dict} />
  <Contacts dict={dict} />

  <Footer slot="footer" lang={lang} dict={dict} nav={nav} />
</Base>
