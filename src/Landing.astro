---
/**
 * Единая сборка лендинга для всех локалей: порядок секций задаётся здесь.
 */
import Footer from './components/Footer.astro';
import Header from './components/Header.astro';
import About from './components/sections/About.astro';
import Advantages from './components/sections/Advantages.astro';
import Hero from './components/sections/Hero.astro';
import Products from './components/sections/Products.astro';
import { getDict, type Lang } from './i18n';
import Base from './layouts/Base.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = getDict(lang);
---

<Base lang={lang} dict={dict}>
  <Header slot="header" lang={lang} dict={dict} />

  <Hero dict={dict} />
  <About dict={dict} />
  <Products dict={dict} />
  <Advantages dict={dict} />

  <Footer slot="footer" lang={lang} dict={dict} />
</Base>
