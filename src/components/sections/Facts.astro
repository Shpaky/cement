---
import type { Dictionary } from '../../i18n';
import Container from '../Container.astro';

interface Props {
  dict: Dictionary;
}
const { dict } = Astro.props;
const t = dict.facts;
---

<section class="bg-brand-800 py-12 text-white md:py-16" aria-label={t.label}>
  <Container>
    <dl class="grid grid-cols-2 gap-8 lg:grid-cols-4">
      {
        t.items.map((f) => (
          <div class="flex flex-col-reverse border-l-2 border-brand-400 pl-4">
            <dt class="mt-2 text-sm text-brand-100 md:text-base">{f.label}</dt>
            <dd class="text-2xl font-extrabold tracking-tight sm:text-3xl md:text-4xl lg:text-5xl">
              {f.value}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-8 text-xs text-brand-200">{t.note}</p>
  </Container>
</section>
