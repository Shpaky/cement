---
import { company } from '../../data/company';
import type { Dictionary } from '../../i18n';
import Button from '../Button.astro';
import Container from '../Container.astro';

interface Props {
  dict: Dictionary;
}
const { dict } = Astro.props;
const t = dict.hero;
---

<section
  id="hero"
  class="relative isolate overflow-hidden bg-brand-800 text-white"
  aria-labelledby="hero-title"
>
  <!-- Декоративный фон: сетка + свечение (без растровых картинок) -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-linear-to-br from-brand-800 via-brand-800 to-brand-900"></div>
    <svg class="absolute inset-0 h-full w-full opacity-10" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="hero-grid" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M48 0H0v48" fill="none" stroke="currentColor" stroke-width="1"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)"></rect>
    </svg>
    <div
      class="absolute -top-1/4 -right-1/4 h-2/3 w-2/3 rounded-full bg-brand-500 opacity-30 blur-3xl"
    >
    </div>
  </div>

  <Container class="grid items-center gap-12 py-16 md:py-24 lg:grid-cols-12 lg:gap-8 lg:py-28">
    <div class="lg:col-span-7">
      <p class="mb-4 text-sm font-bold tracking-widest text-brand-200 uppercase">{t.eyebrow}</p>
      <h1
        id="hero-title"
        class="text-4xl leading-tight font-extrabold tracking-tight text-balance sm:text-5xl lg:text-6xl"
      >
        {t.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-brand-100 md:text-xl">{t.lead}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <Button href={company.phones.in.href} variant="inverse" size="lg">
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"
            ></path>
          </svg>
          {t.ctaCall}
        </Button>
        <Button
          href={company.whatsapp}
          variant="inverse-outline"
          size="lg"
          target="_blank"
          rel="noopener"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M21 12a9 9 0 0 1-13.4 7.8L3 21l1.2-4.6A9 9 0 1 1 21 12Z"></path>
            <path
              d="M9 10a1 1 0 0 0 1 1h1l1 2 2-1a1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 8 8 0 0 1-6-6 2 2 0 0 1 2-2Z"
            ></path>
          </svg>
          {t.ctaWhatsapp}
        </Button>
      </div>

      <ul class="mt-10 flex flex-wrap gap-2" aria-label={t.eyebrow}>
        {
          t.badges.map((b) => (
            <li class="rounded-full border border-white/20 bg-white/10 px-3 py-1 text-sm font-semibold text-brand-50">
              {b}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Иллюстрация: изометрические блоки в фирменных цветах -->
    <div class="hidden lg:col-span-5 lg:block">
      <svg
        viewBox="0 0 320 320"
        class="mx-auto w-full max-w-md drop-shadow-2xl"
        role="img"
        aria-label={t.illustrationAlt}
      >
        <g class="text-brand-200">
          <path class="fill-brand-900" d="M160 70 80 115v90l80 45 80-45v-90L160 70Z" opacity="0.6"
          ></path>
        </g>
        <g>
          <path class="fill-brand-200" d="M160 40 100 74l60 34 60-34-60-34Z"></path>
          <path class="fill-brand-500" d="M100 74v68l60 34v-68l-60-34Z"></path>
          <path class="fill-brand-600" d="M220 74v68l-60 34v-68l60-34Z"></path>
        </g>
        <g>
          <path class="fill-brand-100" d="M100 108 40 142l60 34 60-34-60-34Z"></path>
          <path class="fill-brand-400" d="M40 142v68l60 34v-68l-60-34Z"></path>
          <path class="fill-brand-600" d="M160 142v68l-60 34v-68l60-34Z"></path>
        </g>
        <g>
          <path class="fill-brand-100" d="M220 108l-60 34 60 34 60-34-60-34Z"></path>
          <path class="fill-brand-500" d="M160 142v68l60 34v-68l-60-34Z"></path>
          <path class="fill-brand-800" d="M280 142v68l-60 34v-68l60-34Z"></path>
        </g>
        <g>
          <path class="fill-white" d="M160 176l-60 34 60 34 60-34-60-34Z"></path>
          <path class="fill-brand-400" d="M100 210v68l60 34v-68l-60-34Z"></path>
          <path class="fill-brand-600" d="M220 210v68l-60 34v-68l60-34Z"></path>
        </g>
      </svg>
    </div>
  </Container>
</section>
