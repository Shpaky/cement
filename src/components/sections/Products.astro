---
import { whatsappLink } from '../../data/company';
import { PRODUCT_GROUPS, productsByGroup } from '../../data/products';
import type { Dictionary } from '../../i18n';
import Button from '../Button.astro';
import Container from '../Container.astro';
import ProductCard from '../ProductCard.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  dict: Dictionary;
}
const { dict } = Astro.props;
const t = dict.products;

/** Иконки упаковки: мешок, биг-бэг, судно, паллета (stroke=currentColor) */
const packIcons = [
  'M8 3h8l1 4H7l1-4Z M6 7h12l1 14H5L6 7Z M10 11v6 M14 11v6',
  'M6 8h12v13H6V8Z M9 8V5a3 3 0 0 1 6 0v3 M6 12h12',
  'M3 17l1.5 3h15L21 17H3Z M5 17V10h14v7 M9 10V6h6v4 M12 3v3',
  'M3 16h18 M4 16v3 M12 16v3 M20 16v3 M5 16V9h6v7 M13 16V4h6v12 M5 12h6',
];
---

<section id="products" class="scroll-mt-20 py-16 md:py-24" aria-labelledby="products-title">
  <Container>
    <SectionHeading id="products-title" eyebrow={t.eyebrow} title={t.title} lead={t.lead} />

    {
      PRODUCT_GROUPS.map((group, gi) => (
        <div class:list={[gi > 0 && 'mt-12 lg:mt-16']}>
          <h3 class="text-2xl font-extrabold tracking-tight text-brand-800 md:text-3xl">
            {t.groups[group].title}
          </h3>
          <p class="mt-2 max-w-3xl text-base leading-relaxed text-ink-700 md:text-lg">
            {t.groups[group].lead}
          </p>
          <ul class="mt-6 grid gap-6 md:grid-cols-2">
            {productsByGroup(group).map((product) => (
              <ProductCard product={product} dict={dict} />
            ))}
          </ul>
          {group === 'waterproofing' && <p class="mt-4 text-sm text-ink-500">{t.tdsNote}</p>}
        </div>
      ))
    }

    <div class="mt-12 rounded-lg bg-ink-50 p-6 md:p-8 lg:mt-16">
      <h3 class="text-xl font-bold text-ink-900">{t.packaging.title}</h3>
      <ul class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          t.packaging.items.map((item, i) => (
            <li class="flex gap-4">
              <span
                class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-white text-brand-600 shadow-card"
                aria-hidden="true"
              >
                <svg
                  class="h-6 w-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                >
                  <path d={packIcons[i]} />
                </svg>
              </span>
              <div>
                <p class="font-bold text-ink-900">{item.title}</p>
                <p class="mt-1 text-sm leading-relaxed text-ink-700">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-ink-500">{t.note}</p>
        <Button href={whatsappLink(t.rfqText)} variant="secondary" target="_blank" rel="noopener">
          {t.cta}
        </Button>
      </div>
    </div>
  </Container>
</section>
