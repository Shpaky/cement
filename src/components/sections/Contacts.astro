---
import { company } from '../../data/company';
import type { Dictionary } from '../../i18n';
import Button from '../Button.astro';
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  dict: Dictionary;
}
const { dict } = Astro.props;
const t = dict.contacts;

/** Данные каналов: значение, href, внешняя ли ссылка, иконка (stroke=currentColor) */
const channelData = {
  phoneIn: {
    value: company.phones.in.display,
    href: company.phones.in.href,
    external: false,
    icon: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z',
  },
  phoneRu: {
    value: company.phones.ru.display,
    href: company.phones.ru.href,
    external: false,
    icon: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z',
  },
  email: {
    value: company.email,
    href: `mailto:${company.email}`,
    external: false,
    icon: 'M3 6h18v12H3V6Z M3 7l9 6 9-6',
  },
  whatsapp: {
    value: 'WhatsApp',
    href: company.whatsapp,
    external: true,
    icon: 'M21 12a9 9 0 0 1-13.4 7.8L3 21l1.2-4.6A9 9 0 1 1 21 12Z M9 10a1 1 0 0 0 1 1h1l1 2 2-1a1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 8 8 0 0 1-6-6 2 2 0 0 1 2-2Z',
  },
  telegram: {
    value: 'Telegram',
    href: company.telegram,
    external: true,
    icon: 'M21 4 3 11l6 2 2 6 3-4 5 3 2-14Z M9 13l10-8',
  },
} as const;

const mapLinks = [company.maps.india, company.maps.plant];
---

<section
  id="contacts"
  class="scroll-mt-20 bg-ink-50 py-16 md:py-24"
  aria-labelledby="contacts-title"
>
  <Container>
    <SectionHeading id="contacts-title" eyebrow={t.eyebrow} title={t.title} lead={t.lead} />

    <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <ul class="grid gap-4 sm:grid-cols-2">
          {
            t.channels.map((c) => {
              const d = channelData[c.key];
              return (
                <li>
                  <a
                    href={d.href}
                    target={d.external ? '_blank' : undefined}
                    rel={d.external ? 'noopener' : undefined}
                    class="group flex h-full items-center gap-4 rounded-lg border border-ink-200 bg-white p-5 shadow-card transition-shadow duration-300 ease-out-soft hover:shadow-card-hover"
                  >
                    <span
                      class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-brand-50 text-brand-600 transition-colors duration-300 group-hover:bg-brand-600 group-hover:text-white"
                      aria-hidden="true"
                    >
                      <svg
                        class="h-6 w-6"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        focusable="false"
                      >
                        <path d={d.icon} />
                      </svg>
                    </span>
                    <span class="min-w-0">
                      <span class="block text-xs font-bold tracking-widest text-ink-500 uppercase">
                        {c.label}
                      </span>
                      <span class="mt-0.5 block truncate text-lg font-bold text-ink-900 group-hover:text-brand-600">
                        {d.value}
                      </span>
                      <span class="mt-0.5 block text-sm text-ink-700">{c.hint}</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
          <li class="rounded-lg border border-ink-200 bg-white p-5 shadow-card">
            <p class="text-xs font-bold tracking-widest text-ink-500 uppercase">{t.hoursTitle}</p>
            <ul class="mt-2 flex flex-col gap-1">
              {t.hours.map((h) => <li class="text-sm font-semibold text-ink-900">{h}</li>)}
            </ul>
          </li>
        </ul>
      </div>

      <div class="flex flex-col gap-4 lg:col-span-5">
        {
          t.locations.map((loc, i) => (
            <div class="rounded-lg bg-brand-800 p-6 text-white">
              <p class="text-xs font-bold tracking-widest text-brand-200 uppercase">{loc.title}</p>
              <p class="mt-2 text-lg font-bold">{loc.name}</p>
              <address class="mt-1 text-sm text-brand-100 not-italic">{loc.address}</address>
              <Button
                href={mapLinks[i]}
                variant="inverse-outline"
                class="mt-4"
                target="_blank"
                rel="noopener"
              >
                {loc.mapCta}
              </Button>
            </div>
          ))
        }
        <p class="text-sm text-ink-500">{t.note}</p>
      </div>
    </div>
  </Container>
</section>
