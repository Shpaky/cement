---
import type { Dictionary } from '../../i18n';
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  dict: Dictionary;
}
const { dict } = Astro.props;
const t = dict.certificates;
const scanSlots = [1, 2, 3, 4];
---

<section id="certificates" class="scroll-mt-20 py-16 md:py-24" aria-labelledby="certificates-title">
  <Container>
    <SectionHeading id="certificates-title" eyebrow={t.eyebrow} title={t.title} lead={t.lead} />

    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.standards.map((s) => (
          <li class="flex flex-col rounded-lg border border-ink-200 bg-white p-6 shadow-card">
            <span class="inline-flex w-fit items-center rounded-sm bg-brand-800 px-2.5 py-1 text-xs font-bold tracking-widest text-white uppercase">
              {s.code}
            </span>
            <h3 class="mt-4 text-lg font-bold text-ink-900">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-700">{s.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 grid gap-8 lg:mt-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <h3 class="text-xl font-bold text-ink-900">{t.documentsTitle}</h3>
        <ul class="mt-5 flex flex-col gap-3">
          {
            t.documents.map((d) => (
              <li class="flex gap-3 text-base text-ink-700">
                <svg
                  class="mt-0.5 h-5 w-5 shrink-0 text-brand-600"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{d}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-7">
        <h3 class="text-xl font-bold text-ink-900">{t.scansTitle}</h3>
        <ul class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4" aria-label={t.scansTitle}>
          {
            scanSlots.map((n) => (
              <li class="flex aspect-3/4 flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed border-ink-300 bg-ink-50 p-3 text-center">
                <svg
                  class="h-8 w-8 text-ink-400"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M6 3h9l5 5v13H6V3Z M14 3v6h6 M9 13h6 M9 17h6" />
                </svg>
                <span class="text-xs font-semibold text-ink-500">
                  {t.scansPlaceholder} {n}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-ink-500">{t.note}</p>
      </div>
    </div>
  </Container>
</section>
