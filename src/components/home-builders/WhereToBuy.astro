---
/**
 * «Где купить»: пока дилерской сети нет — текст, приоритетные штаты и WhatsApp.
 * Контейнер [data-dealers] зарезервирован под таблицу дилеров по штатам.
 */
import { whatsappLink } from '../../data/company';
import type { HbDictionary, HbLang } from '../../i18n/home-builders';
import Button from '../Button.astro';
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  lang: HbLang;
  hb: HbDictionary;
}
const { hb } = Astro.props;
const t = hb.whereToBuy;
---

<section id="whereToBuy" class="scroll-mt-20 py-16 md:py-24" aria-labelledby="where-to-buy-title">
  <Container>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <SectionHeading
          id="where-to-buy-title"
          eyebrow={t.eyebrow}
          title={t.title}
          lead={t.lead}
          class="mb-6 md:mb-8"
        />
        <Button href={whatsappLink(t.whatsappText)} size="lg" target="_blank" rel="noopener">
          {t.cta}
        </Button>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-lg border border-ink-200 bg-white p-6 shadow-card md:p-8">
          <h3 class="text-lg font-bold text-ink-900">{t.statesTitle}</h3>
          <ul class="mt-4 flex flex-wrap gap-2" aria-label={t.statesTitle}>
            {
              t.states.map((s) => (
                <li class="rounded-full bg-brand-50 px-4 py-1.5 text-sm font-semibold text-brand-800">
                  {s}
                </li>
              ))
            }
          </ul>
          <!-- Место под таблицу дилеров по штатам (появится вместе с партнёрами) -->
          <div
            class="mt-6 rounded-md border border-dashed border-ink-300 bg-ink-50 p-4"
            data-dealers
          >
            <p class="text-sm text-ink-700">{t.dealersNote}</p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
