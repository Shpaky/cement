---
/**
 * Гид по гидроизоляции: схема дома с пятью пронумерованными зонами (SVG,
 * aria-hidden) и список зон с текстом. Порядок номеров на схеме = порядок
 * `hb.waterproofing.zones`: фундамент, стены, крыша, ванная/кухня, резервуар.
 */
import type { HbDictionary, HbLang } from '../../i18n/home-builders';
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  lang: HbLang;
  hb: HbDictionary;
}
const { hb } = Astro.props;
const t = hb.waterproofing;

/** Координаты маркеров зон на схеме (viewBox 400×360). */
const markers = [
  { x: 200, y: 318 },
  { x: 62, y: 210 },
  { x: 200, y: 92 },
  { x: 268, y: 232 },
  { x: 318, y: 66 },
];
---

<section
  id="waterproofing"
  class="scroll-mt-20 bg-ink-50 py-16 md:py-24"
  aria-labelledby="waterproofing-title"
>
  <Container>
    <SectionHeading id="waterproofing-title" eyebrow={t.eyebrow} title={t.title} lead={t.lead} />

    <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
      <!-- Схема дома в разрезе -->
      <figure class="lg:col-span-6">
        <svg
          viewBox="0 0 400 360"
          class="h-auto w-full rounded-lg border border-ink-200 bg-white shadow-card"
          role="img"
          aria-label={t.illustrationAlt}
        >
          <!-- грунт и фундамент (зона 1) -->
          <path d="M0 300h400v60H0z" class="fill-ink-100"></path>
          <path d="M90 290h220v42H90z" class="fill-brand-800"></path>
          <!-- стены (зона 2) -->
          <path d="M100 150h20v140h-20z M280 150h20v140h-20z" class="fill-brand-600"></path>
          <!-- интерьер -->
          <path d="M120 150h160v140H120z" class="fill-brand-50"></path>
          <!-- перекрытие и крыша/терраса (зона 3) -->
          <path d="M90 130h220v20H90z" class="fill-brand-500"></path>
          <path d="M90 110h220v20H90z" class="fill-brand-200"></path>
          <!-- ванная/кухня (зона 4) -->
          <path d="M210 190h70v100h-70z" class="fill-brand-100"></path>
          <path d="M210 190h70v6h-70z M210 284h70v6h-70z" class="fill-brand-400"></path>
          <!-- резервуар на крыше (зона 5) -->
          <path d="M290 60h50v50h-50z" class="fill-brand-600"></path>
          <path d="M296 66h38v38h-38z" class="fill-brand-400"></path>
          <!-- дверь и окно -->
          <path d="M150 230h30v60h-30z" class="fill-brand-800"></path>
          <path d="M140 170h40v30h-40z" class="fill-brand-400"></path>
          <!-- дождь -->
          <g class="stroke-brand-400" stroke-width="3" stroke-linecap="round" fill="none">
            <path d="M40 40v16 M60 20v16 M350 30v16 M370 50v16 M20 80v16"></path>
          </g>
          <!-- маркеры зон -->
          {
            markers.map((m, i) => (
              <g>
                <circle cx={m.x} cy={m.y} r="16" class="fill-brand-800" />
                <circle
                  cx={m.x}
                  cy={m.y}
                  r="16"
                  fill="none"
                  class="stroke-white"
                  stroke-width="3"
                />
                <text
                  x={m.x}
                  y={m.y + 6}
                  text-anchor="middle"
                  class="fill-white font-sans text-base font-extrabold"
                >
                  {i + 1}
                </text>
              </g>
            ))
          }
        </svg>
        <figcaption class="sr-only">{t.illustrationAlt}</figcaption>
      </figure>

      <!-- Список зон -->
      <div class="lg:col-span-6">
        <ol class="flex flex-col gap-4">
          {
            t.zones.map((zone, i) => (
              <li class="flex gap-4 rounded-lg border border-ink-200 bg-white p-5 shadow-card">
                <span
                  class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-800 text-sm font-extrabold text-white"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <div>
                  <h3 class="text-lg font-bold text-ink-900">{zone.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-ink-700">{zone.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="mt-8 rounded-lg bg-brand-800 px-6 py-5 text-lg font-bold text-white md:text-xl">
          {t.thesis}
        </p>
      </div>
    </div>
  </Container>
</section>
